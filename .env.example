# =============================================================================
# Job Outreach Agent — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# =============================================================================

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL + pgvector) ---
POSTGRES_USER=outreach
POSTGRES_PASSWORD=outreach_dev_password
POSTGRES_DB=job_outreach
DATABASE_URL=postgresql+asyncpg://outreach:outreach_dev_password@postgres:5432/job_outreach
DATABASE_URL_SYNC=postgresql://outreach:outreach_dev_password@postgres:5432/job_outreach

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Auth (app login — Google OAuth optional for MVP; local demo user works without) ---
# Google OAuth for app sign-in (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Gmail API (sending) — https://console.cloud.google.com/ ---
# Enable Gmail API; OAuth client type "Web application"
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/oauth/gmail/callback
# If unset, send path is a safe no-op that logs "would send"

# --- Microsoft Graph (Outlook sending) ---
# Azure App Registration with Mail.Send delegated permission
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:8000/api/oauth/microsoft/callback

# --- LLM Providers (at least one; mock used when none set) ---
LLM_PROVIDER=mock
# Options: mock | openai | gemini | anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Outreach limits (anti-spam) ---
DEFAULT_DAILY_SEND_LIMIT=10
DEFAULT_PER_COMPANY_SEND_LIMIT=2
REQUIRE_APPROVAL=true

# --- Encryption for OAuth tokens at rest ---
TOKEN_ENCRYPTION_KEY=change-me-fernet-key-32bytes-base64=

# --- Seed user (dev only) ---
SEED_USER_EMAIL=archit@example.com
SEED_USER_NAME=Archit
